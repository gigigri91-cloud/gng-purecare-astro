---
import Icon from './Icon.astro';
import { hasSocialLinks, socialLinks } from '../data/social';

const year = new Date().getFullYear();
const showSocial = hasSocialLinks();
---
<footer class="border-t border-border bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-4 md:px-6">
    <div class="md:col-span-2">
      <a href="/" class="footer__logo" aria-label="GNG PureCare - Acasă">
        <img
          class="footer__logo-mark"
          src="/images/logo-symbol.png"
          alt=""
          width="46"
          height="46"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
        <span class="footer__logo-wordmark">
          <span class="footer__logo-gng">GNG</span>
          <span class="footer__logo-brand">
            Pure<span class="footer__logo-care">Care</span>
          </span>
        </span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted-foreground">
        Servicii profesionale de curățenie pentru apartamente, birouri și spații după renovare. Lucrăm în București și zonele limitrofe.
      </p>
      {showSocial && (
        <div class="mt-5 flex flex-wrap gap-2">
          {socialLinks.facebook.trim() && (
            <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="grid h-9 w-9 place-items-center rounded-full border border-border text-muted-foreground hover:border-primary hover:text-primary">
              <Icon name="facebook" class="h-4 w-4" />
            </a>
          )}
          {socialLinks.instagram.trim() && (
            <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="grid h-9 w-9 place-items-center rounded-full border border-border text-muted-foreground hover:border-primary hover:text-primary">
              <Icon name="instagram" class="h-4 w-4" />
            </a>
          )}
          {socialLinks.linkedin.trim() && (
            <a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="grid h-9 w-9 place-items-center rounded-full border border-border text-muted-foreground hover:border-primary hover:text-primary">
              <Icon name="linkedin" class="h-4 w-4" />
            </a>
          )}
        </div>
      )}
    </div>
    <div>
      <h3 class="mb-4 text-sm font-semibold">Navigare</h3>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li><a href="/" class="hover:text-primary">Acasă</a></li>
        <li><a href="/servicii" class="hover:text-primary">Servicii</a></li>
        <li><a href="/despre" class="hover:text-primary">Despre noi</a></li>
        <li><a href="/contact" class="hover:text-primary">Contact</a></li>
      </ul>
    </div>
    <div>
      <h3 class="mb-4 text-sm font-semibold">Contact</h3>
      <ul class="space-y-3 text-sm text-muted-foreground">
        <li class="flex items-start gap-2"><Icon name="phone" class="mt-0.5 h-4 w-4 text-primary"/><a href="tel:+40747821384" class="hover:text-primary">0747 821 384</a></li>
        <li class="flex items-start gap-2"><Icon name="mail" class="mt-0.5 h-4 w-4 text-primary"/><a href="mailto:contact@gngpurecare.ro" class="hover:text-primary">contact@gngpurecare.ro</a></li>
        <li class="flex items-start gap-2"><Icon name="pin" class="mt-0.5 h-4 w-4 text-primary"/><span>București, România</span></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-5 text-xs text-muted-foreground md:flex-row md:px-6">
      <p>© {year} GNG PureCare. Toate drepturile rezervate.</p>
      <div class="flex items-center gap-4">
        <a href="/confidentialitate" class="hover:text-primary">Politică de confidențialitate</a>
        <span>•</span>
        <p>Curățenie fără griji • București</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  .footer__logo-mark {
    display: block;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .footer__logo-wordmark {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.05rem;
    line-height: 1;
  }

  .footer__logo-gng {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #00695c;
  }

  .footer__logo-brand {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #008080;
  }

  .footer__logo-care {
    color: #2d9a8a;
    font-weight: 600;
  }
</style>
