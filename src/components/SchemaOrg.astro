---
import { business } from '../data/business';

interface Props {
  page?: 'home' | 'despre' | 'servicii' | 'contact' | 'confidentialitate';
}

const { page = 'home' } = Astro.props;

const pageNames: Record<string, string> = {
  despre: 'Despre noi',
  servicii: 'Servicii',
  contact: 'Contact',
  confidentialitate: 'Politică de confidențialitate',
};

const breadcrumbSchema = page !== 'home' && pageNames[page] ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Acasă',
      item: business.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: pageNames[page],
      item: `${business.url}/${page}`,
    },
  ],
} : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${business.url}/#localbusiness`,
  name: business.name,
  description:
    'Servicii profesionale de curățenie pentru apartamente, birouri și spații după renovare în București.',
  url: business.url,
  logo: business.logo,
  image: business.image,
  telephone: business.telephone,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.streetAddress,
    addressLocality: business.address.addressLocality,
    addressRegion: business.address.addressRegion,
    postalCode: business.address.postalCode,
    addressCountry: business.address.addressCountry,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  areaServed: [
    { '@type': 'City', name: 'București' },
    { '@type': 'AdministrativeArea', name: 'Sector 1' },
    { '@type': 'AdministrativeArea', name: 'Sector 2' },
    { '@type': 'AdministrativeArea', name: 'Sector 3' },
    { '@type': 'AdministrativeArea', name: 'Sector 4' },
    { '@type': 'AdministrativeArea', name: 'Sector 5' },
    { '@type': 'AdministrativeArea', name: 'Sector 6' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: '09:00',
      closes: '18:00',
    },
  ],
  priceRange: '$$',
  currenciesAccepted: 'RON',
  paymentAccepted: 'Cash, Transfer bancar',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicii de curățenie',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Curățenie apartamente București',
          description: 'Curățenie profesională completă pentru apartamente în București',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Curățenie birouri București',
          description: 'Servicii de igienizare și curățenie pentru spații de birou',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Curățenie după renovare București',
          description:
            'Curățenie post-construcție și renovare pentru spații rezidențiale și comerciale',
        },
      },
    ],
  },
  sameAs: business.sameAs,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
