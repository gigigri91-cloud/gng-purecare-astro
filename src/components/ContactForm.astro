---
// Formspree endpoint — same as React version
const FORMSPREE = 'https://formspree.io/f/mrejdjjk';
const site = import.meta.env.SITE ?? 'https://gngpurecare.ro';
const thankYouUrl = new URL('/multumim/', site).href;

interface Props {
  /** Unic pe pagină pentru id-uri accesibile când există mai multe formulare. */
  instanceId?: string;
}
const { instanceId = 'default' } = Astro.props;
const fieldId = (base: string) => `${base}-${instanceId}`;
---
<form action={FORMSPREE} method="POST" class="contact-form relative grid gap-4" data-instance={instanceId}>
  <input type="hidden" name="_next" value={thankYouUrl}/>
  <div class="pointer-events-none absolute -left-[9999px] top-0 h-px w-px overflow-hidden opacity-0" aria-hidden="true">
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" title="Nu completa acest câmp"/>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid gap-2">
      <label for={fieldId('name')} class="text-sm font-medium">Nume complet <span class="text-primary">*</span></label>
      <input
        id={fieldId('name')}
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder="Ion Popescu"
        class="h-11 rounded-md border border-border bg-background px-3 text-base focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
      />
    </div>
    <div class="grid gap-2">
      <label for={fieldId('phone')} class="text-sm font-medium">Telefon <span class="text-primary">*</span></label>
      <input
        id={fieldId('phone')}
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        required
        placeholder="07xx xxx xxx"
        class="phone-input h-11 rounded-md border border-border bg-background px-3 text-base focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
      />
      <span id={fieldId('phone-error')} class="phone-error-msg hidden text-xs font-medium text-destructive" role="alert"></span>
    </div>
  </div>
  <div class="grid gap-2">
    <label for={fieldId('email')} class="text-sm font-medium">Email <span class="text-primary">*</span></label>
    <input
      id={fieldId('email')}
      name="email"
      type="email"
      autocomplete="email"
      required
      placeholder="nume@exemplu.ro"
      class="h-11 rounded-md border border-border bg-background px-3 text-base focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
    />
  </div>
  <div class="grid gap-2">
    <label for={fieldId('service')} class="text-sm font-medium">Tip serviciu <span class="text-primary">*</span></label>
    <select
      id={fieldId('service')}
      name="service"
      required
      class="h-11 rounded-md border border-border bg-background px-3 text-base focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
    >
      <option value="" disabled selected>Alege un serviciu...</option>
      <option value="apartament">Curățenie apartament / rezidențială</option>
      <option value="birou">Curățenie birou / comercială</option>
      <option value="dupa_renovare">Curățenie după renovare / construcție</option>
      <option value="dupa_eveniment">Curățenie după eveniment</option>
      <option value="alta">Alt tip de curățenie</option>
    </select>
  </div>
  <div class="grid gap-2">
    <label for={fieldId('message')} class="text-sm font-medium">Detalii suplimentare</label>
    <textarea
      id={fieldId('message')}
      name="message"
      rows="4"
      placeholder="Suprafață aproximativă (mp), număr de camere, frecvență sau cerințe speciale..."
      class="rounded-md border border-border bg-background px-3 py-2 text-base focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
    ></textarea>
  </div>

  <div class="flex items-start gap-2.5 pt-1">
    <input
      type="checkbox"
      id={fieldId('gdpr')}
      name="gdpr_consent"
      required
      class="mt-1 h-4 w-4 rounded border-border text-primary accent-primary focus:ring-primary"
    />
    <label for={fieldId('gdpr')} class="text-xs leading-relaxed text-muted-foreground">
      Sunt de acord cu prelucrarea datelor mele cu caracter personal pentru transmiterea ofertei conform <a href="/confidentialitate" class="font-medium text-primary underline hover:text-primary-hover" target="_blank" rel="noopener">Politicii de Confidențialitate</a>. <span class="text-primary">*</span>
    </label>
  </div>

  <!-- Zona de feedback si erori generale anti-spam / validare -->
  <div class="form-feedback hidden rounded-lg border border-destructive/40 bg-destructive/10 p-3 text-center text-xs font-medium text-destructive" role="alert" aria-live="polite"></div>

  <!--
    NOTA DE SECURITATE / ANTI-SPAM PENTRU DEPLOY:
    Daca doriti protectie suplimentara cu Cloudflare Turnstile (CAPTCHA invizibil):
    1. Obtineti un Site Key din panoul Cloudflare -> Turnstile.
    2. Adaugati scriptul Turnstile: https://challenges.cloudflare.com/turnstile/v0/api.js in Layout.astro sau direct aici.
    3. Includeti un element <div class="cf-turnstile" data-sitekey="SITE_KEY"></div> inainte de buton.
    4. Adaugati 'https://challenges.cloudflare.com' in CSP (script-src si frame-src) in public/_headers.
    5. In Formspree Dashboard activati verificarea automata a Turnstile Secret.
  -->

  <button
    type="submit"
    class="submit-btn mt-2 inline-flex h-12 items-center justify-center gap-2 rounded-full bg-primary px-6 text-base font-semibold text-primary-foreground transition-all hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
  >
    <span class="btn-text">Trimite mesajul</span>
    <span class="btn-loader hidden">
      <svg class="h-5 w-5 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </span>
  </button>
  <p class="text-center text-xs text-muted-foreground">
    Răspundem de regulă în 24–48 de ore. Datele tale sunt strict confidențiale.
  </p>
</form>

<script>
  function setupContactForms() {
    // 1. Prefill service from URL query params (ex: ?serviciu=birou)
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = urlParams.get('serviciu') || urlParams.get('service');

    document.querySelectorAll<HTMLFormElement>('form.contact-form').forEach((form) => {
      if (form.dataset.initialized === 'true') return;
      form.dataset.initialized = 'true';

      const formMountTime = Date.now();
      const phoneInput = form.querySelector<HTMLInputElement>('.phone-input');
      const phoneError = form.querySelector<HTMLElement>('.phone-error-msg');
      const feedbackBox = form.querySelector<HTMLElement>('.form-feedback');
      const gotchaInput = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
      const submitBtn = form.querySelector<HTMLButtonElement>('.submit-btn');
      const btnText = form.querySelector<HTMLElement>('.btn-text');
      const btnLoader = form.querySelector<HTMLElement>('.btn-loader');

      const select = form.querySelector<HTMLSelectElement>('select[name="service"]');
      if (serviceParam && select) {
        const optionExists = Array.from(select.options).some(opt => opt.value === serviceParam);
        if (optionExists) {
          select.value = serviceParam;
        }
      }

      // Reset eroare la tastare in campul de telefon
      if (phoneInput) {
        phoneInput.addEventListener('input', () => {
          phoneInput.classList.remove('border-destructive', 'focus:border-destructive');
          if (phoneError) {
            phoneError.classList.add('hidden');
            phoneError.textContent = '';
          }
        });
      }

      // Validare si protectie anti-spam la submit
      form.addEventListener('submit', (e) => {
        // Reset feedback
        if (feedbackBox) {
          feedbackBox.classList.add('hidden');
          feedbackBox.textContent = '';
        }

        // Anti-spam 1: Honeypot check (robotii completeaza campul invizibil)
        if (gotchaInput && gotchaInput.value.trim().length > 0) {
          e.preventDefault();
          return;
        }

        // Anti-spam 2: Time-trap (completare automata in sub 2 secunde)
        const elapsedSeconds = (Date.now() - formMountTime) / 1000;
        if (elapsedSeconds < 2) {
          e.preventDefault();
          if (feedbackBox) {
            feedbackBox.textContent = 'Trimiterea s-a realizat prea rapid. Te rugăm să reîncerci.';
            feedbackBox.classList.remove('hidden');
          }
          return;
        }

        // Anti-spam 3: Client Rate-Limiting / Cooldown (prevenire spam click si flood)
        const lastSubmit = sessionStorage.getItem('gng_form_last_submit');
        if (lastSubmit) {
          const timeSinceLast = Date.now() - parseInt(lastSubmit, 10);
          if (timeSinceLast < 45000) {
            e.preventDefault();
            const waitSeconds = Math.ceil((45000 - timeSinceLast) / 1000);
            if (feedbackBox) {
              feedbackBox.textContent = `Ai trimis deja o solicitare recent. Te rugăm să aștepți încă ${waitSeconds} secunde.`;
              feedbackBox.classList.remove('hidden');
            }
            return;
          }
        }

        // Validare stricta a numarului de telefon pentru Romania
        if (phoneInput) {
          const rawPhone = phoneInput.value.trim();
          const cleanedPhone = rawPhone.replace(/[\s\-\.\(\)]/g, '');
          // Formate valide permise:
          // 07xxxxxxxx (10 cifre)
          // +407xxxxxxxx (12 caractere)
          // 00407xxxxxxxx (13 caractere)
          const roPhoneRegex = /^(?:(?:\+4|004)0?7\d{8}|07\d{8})$/;

          if (!roPhoneRegex.test(cleanedPhone)) {
            e.preventDefault();
            phoneInput.classList.add('border-destructive');
            if (phoneError) {
              phoneError.textContent = 'Introdu un număr valid de mobil din România (ex: 0721 234 567 sau +40 721 234 567).';
              phoneError.classList.remove('hidden');
            }
            phoneInput.focus();
            return;
          }
        }

        // Daca toate validarile trec, marcam timestamp-ul in sesiune si afisam starea de incarcare
        sessionStorage.setItem('gng_form_last_submit', Date.now().toString());

        if (submitBtn && btnText && btnLoader) {
          submitBtn.disabled = true;
          btnText.textContent = 'Se trimite mesajul...';
          btnLoader.classList.remove('hidden');
        }
      });
    });

    // 3. Listen for in-page service selection clicks
    if (!document.body.dataset.serviceListenerAdded) {
      document.body.dataset.serviceListenerAdded = 'true';
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('a[data-service]');
        if (!target) return;
        const service = target.getAttribute('data-service');
        if (!service) return;
        document.querySelectorAll<HTMLSelectElement>('select[name="service"]').forEach((select) => {
          const exists = Array.from(select.options).some(opt => opt.value === service);
          if (exists) select.value = service;
        });
      });
    }
  }

  setupContactForms();
  document.addEventListener('astro:page-load', setupContactForms);
</script>
