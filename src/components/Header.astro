---
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const NAV = [
  { href: '/', label: 'Acasă' },
  { href: '/servicii', label: 'Servicii' },
  { href: '/despre', label: 'Despre' },
  { href: '/#contact', label: 'Contact' },
];

const isActive = (href: string) => {
  if (href === '/#contact') return path === '/' || path === '/contact';
  if (href === '/') return path === '/';
  return path.startsWith(href);
};
---

<header id="main-header" class="site-header">
  <div class="header-inner">
    <a href="/" class="navbar__logo" aria-label="GNG PureCare - Acasă">
      <img
        class="navbar__logo-mark"
        src="/images/logo-symbol.png"
        alt=""
        width="44"
        height="44"
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
      <span class="navbar__logo-wordmark" aria-hidden="true">
        <span class="navbar__logo-gng">GNG</span>
        <span class="navbar__logo-brand">
          Pure<span class="navbar__logo-care">Care</span>
        </span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Navigare principală">
      <ul class="nav-list">
        <span class="nav-indicator" aria-hidden="true"></span>
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { 'is-active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="tel:+40747821384" class="header-phone">
        <Icon name="phone" class="header-phone__icon" />
        0747 821 384
      </a>
      <a href="/#contact" class="btn-cta">Solicită ofertă</a>
    </div>

    <details class="mobile-menu">
      <summary class="hamburger-btn mobile-menu__toggle" aria-label="Deschide meniul">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </summary>
      <div class="mobile-menu__panel">
        <nav aria-label="Navigare mobilă">
          <ul class="mobile-nav-list">
            {NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['mobile-nav-link', { 'is-active': isActive(item.href) }]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <a href="tel:+40747821384" class="mobile-nav-phone">
            <Icon name="phone" class="h-4 w-4" />
            0747 821 384
          </a>
          <a href="/#contact" class="btn-cta btn-cta--mobile">Solicită ofertă</a>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: transparent;
    border: 1px solid transparent;
    box-shadow: none;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header.scrolled {
    width: min(860px, 90vw);
    left: 50%;
    transform: translateX(-50%);
    top: 16px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(0, 128, 128, 0.15);
    box-shadow: 0 8px 40px rgba(0, 128, 128, 0.12);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: 12px 1rem;
    transition: padding 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header.scrolled .header-inner {
    padding: 8px 24px;
  }

  /* Logo */
  .navbar__logo {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    z-index: 1;
  }

  .navbar__logo-mark {
    display: block;
    width: 40px;
    height: 40px;
    object-fit: contain;
    transition: filter 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header:not(.scrolled) .navbar__logo-mark {
    filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
  }

  .site-header.scrolled .navbar__logo-mark {
    filter: none;
  }

  .navbar__logo-wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
    gap: 0.05rem;
    transition: color 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .navbar__logo-gng {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .navbar__logo-brand {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .site-header:not(.scrolled) .navbar__logo-gng,
  .site-header:not(.scrolled) .navbar__logo-brand,
  .site-header:not(.scrolled) .navbar__logo-care {
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
  }

  .site-header:not(.scrolled) .navbar__logo-care {
    color: rgba(255, 255, 255, 0.92);
  }

  .site-header.scrolled .navbar__logo-gng {
    color: #00695c;
    text-shadow: none;
  }

  .site-header.scrolled .navbar__logo-brand {
    color: #008080;
    text-shadow: none;
  }

  .site-header.scrolled .navbar__logo-care {
    color: #2d9a8a;
    text-shadow: none;
  }

  /* Desktop nav */
  .main-nav {
    display: none;
    flex: 1;
    justify-content: center;
  }

  .nav-list {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list li {
    list-style: none;
  }

  .nav-indicator {
    position: absolute;
    bottom: 2px;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #008080;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%);
    transition:
      left 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease;
  }

  .nav-list:hover .nav-indicator,
  .nav-list:focus-within .nav-indicator {
    opacity: 1;
  }

  .nav-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 9999px;
    will-change: transform;
  }

  .site-header:not(.scrolled) .nav-link {
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .site-header:not(.scrolled) .nav-link:hover,
  .site-header:not(.scrolled) .nav-link.is-active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .site-header.scrolled .nav-link {
    color: #1a1a1a;
    text-shadow: none;
  }

  .site-header.scrolled .nav-link:hover,
  .site-header.scrolled .nav-link.is-active {
    color: #008080;
    background: rgba(0, 128, 128, 0.08);
  }

  /* Header actions */
  .header-actions {
    display: none;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header-phone__icon {
    width: 1rem;
    height: 1rem;
  }

  .site-header:not(.scrolled) .header-phone {
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .site-header.scrolled .header-phone {
    color: #1a1a1a;
    text-shadow: none;
  }

  .site-header.scrolled .header-phone:hover {
    color: #008080;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    background: #008080;
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 128, 128, 0.25);
    transition:
      background-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header:not(.scrolled) .btn-cta {
    background: #ffffff;
    color: #008080;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .btn-cta:hover {
    background: #005f5f;
    transform: translateY(-1px);
  }

  .site-header:not(.scrolled) .btn-cta:hover {
    background: #f0fafa;
    color: #005f5f;
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    margin-left: auto;
    flex-shrink: 0;
  }

  .hamburger-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(0, 0, 0, 0.2);
    color: #ffffff;
    cursor: pointer;
    list-style: none;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hamburger-btn::-webkit-details-marker {
    display: none;
  }

  .site-header.scrolled .hamburger-btn {
    border-color: rgba(0, 128, 128, 0.2);
    background: rgba(255, 255, 255, 0.9);
    color: #1a1a1a;
  }

  .mobile-menu__panel {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2rem 1.5rem;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .mobile-menu:not([open]) .mobile-menu__panel {
    display: none;
  }

  .mobile-menu__panel nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 20rem;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .mobile-nav-list li {
    width: 100%;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 1rem 2rem;
    font-size: 1.5rem;
    font-weight: 600;
    color: #1a1a1a;
    text-decoration: none;
    border-radius: 0.75rem;
  }

  .mobile-nav-link.is-active,
  .mobile-nav-link:hover {
    background: rgba(0, 128, 128, 0.08);
    color: #008080;
  }

  .mobile-nav-phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    margin-top: 0.5rem;
    padding: 0.75rem 2rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: #008080;
    text-decoration: none;
  }

  .btn-cta--mobile {
    display: inline-flex;
    width: auto;
    min-width: 12rem;
    margin-top: 1rem;
    justify-content: center;
    font-size: 1rem;
    min-height: 48px;
  }

  @media (min-width: 768px) {
    .main-nav {
      display: flex;
    }

    .header-actions {
      display: flex;
    }

    .mobile-menu {
      display: none !important;
    }

    .navbar__logo-mark {
      width: 44px;
      height: 44px;
    }

    .navbar__logo-brand {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 767px) {
    .main-nav,
    .header-actions,
    .header-actions .header-phone,
    .header-actions .btn-cta {
      display: none !important;
    }

    .mobile-menu {
      display: block;
    }

    .site-header,
    .site-header.scrolled {
      width: 100% !important;
      left: 0 !important;
      transform: none !important;
      border-radius: 0 !important;
      top: 0 !important;
      padding-inline: 0 !important;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      max-width: none;
      height: 64px;
      padding: 0 1rem;
      gap: 0.75rem;
    }

    .site-header.scrolled .header-inner {
      padding: 0 1rem;
    }

    .navbar__logo {
      min-width: 0;
      flex: 1;
    }

    .navbar__logo-wordmark {
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .header-inner,
    .navbar__logo-mark,
    .navbar__logo-wordmark,
    .nav-indicator,
    .nav-link,
    .header-phone,
    .btn-cta,
    .mobile-menu__toggle {
      transition: none;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById('main-header');
    if (!header || header.dataset.init === 'true') return;
    header.dataset.init = 'true';

    const SCROLL_THRESHOLD = 80;
    const MAGNET_RADIUS = 80;

    const updateScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > SCROLL_THRESHOLD);
    };

    updateScroll();
    window.addEventListener('scroll', updateScroll, { passive: true });

    const navList = header.querySelector<HTMLUListElement>('.nav-list');
    const indicator = header.querySelector<HTMLElement>('.nav-indicator');
    const links = header.querySelectorAll<HTMLAnchorElement>('.nav-link');

    const placeIndicator = (link: HTMLElement) => {
      if (!navList || !indicator) return;
      const listRect = navList.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      const centerX = linkRect.left + linkRect.width / 2 - listRect.left;
      indicator.style.left = `${centerX}px`;
      indicator.style.opacity = '1';
    };

    const resetIndicator = () => {
      if (!indicator) return;
      const active = header.querySelector<HTMLAnchorElement>('.nav-link.is-active');
      if (active) {
        placeIndicator(active);
      } else {
        indicator.style.opacity = '0';
      }
    };

    if (navList && indicator && links.length) {
      const active = header.querySelector<HTMLAnchorElement>('.nav-link.is-active');
      if (active) placeIndicator(active);

      links.forEach((link) => {
        link.addEventListener('mouseenter', () => placeIndicator(link));

        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          link.addEventListener('mousemove', (e) => {
            const rect = link.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            const dx = e.clientX - cx;
            const dy = e.clientY - cy;
            const dist = Math.hypot(dx, dy);
            if (dist < MAGNET_RADIUS) {
              link.style.transform = `translate(${dx * 0.3}px, ${dy * 0.3}px)`;
              link.style.transition = 'transform 0.1s ease';
            }
          });

          link.addEventListener('mouseleave', () => {
            link.style.transform = 'translate(0, 0)';
            link.style.transition = 'transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
          });
        }
      });

      navList.addEventListener('mouseleave', resetIndicator);
    }

    const mobileMenu = header.querySelector<HTMLDetailsElement>('.mobile-menu');

    if (mobileMenu) {
      mobileMenu.addEventListener('toggle', () => {
        document.body.style.overflow = mobileMenu.open ? 'hidden' : '';
      });

      mobileMenu.querySelectorAll<HTMLAnchorElement>(
        '.mobile-nav-link, .mobile-nav-phone, .btn-cta--mobile'
      ).forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.open = false;
          document.body.style.overflow = '';
        });
      });
    }
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
