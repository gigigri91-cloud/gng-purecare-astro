---
import afterImg from '../assets/images/after-cleaning.jpg';
import beforeImg from '../assets/images/before-cleaning.jpg';
---

<section class="ba-section">
  <div class="wrap">
    <div class="rezultate-intro">
      <h2 class="ba-title">Rezultate care se văd</h2>
      <p class="ba-sub">
        Trage linia pentru a vedea diferența înainte și după intervenția echipei GNG PureCare.
      </p>
    </div>

    <div class="ba-slider" id="baSlider">
      <div class="ba-after">
        <img
          src={afterImg.src}
          alt="Apartament după curățenie profesională GNG PureCare"
          width={afterImg.width}
          height={afterImg.height}
          loading="eager"
          decoding="async"
          style="width: 100%; height: 100%; object-fit: cover;"
        />
      </div>
      <div class="ba-before" id="baBefore">
        <img
          src={beforeImg.src}
          alt="Apartament înainte de curățenie"
          width={beforeImg.width}
          height={beforeImg.height}
          loading="lazy"
          decoding="async"
          style="width: 100%; height: 100%; object-fit: cover;"
        />
      </div>
      <div class="ba-handle" id="baHandle">
        <div class="ba-line"></div>
        <div class="ba-circle">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" aria-hidden="true">
            <path d="M8 3l-5 9 5 9M16 3l5 9-5 9"></path>
          </svg>
        </div>
        <div class="ba-line"></div>
      </div>
      <span class="ba-label ba-label--left">ÎNAINTE</span>
      <span class="ba-label ba-label--right">DUPĂ</span>
    </div>
  </div>
</section>

<style>
  .ba-section {
    padding: clamp(3rem, 6vw, 6rem) 0;
    background: #f7fbfb;
  }
  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .ba-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    color: #223434;
    margin: 0 0 12px;
  }
  .rezultate-intro p {
    max-width: 60ch;
  }
  .ba-sub {
    color: #607777;
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 32px;
  }
  .ba-slider {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 24px;
    overflow: hidden;
    cursor: ew-resize;
    user-select: none;
    touch-action: none;
    box-shadow: 0 20px 50px rgba(0, 80, 80, 0.12);
  }
  .ba-after,
  .ba-before {
    position: absolute;
    inset: 0;
  }
  .ba-after img,
  .ba-before img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }
  .ba-before {
    clip-path: inset(0 50% 0 0);
    transition: clip-path 0.05s linear;
  }
  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 4;
    pointer-events: none;
  }
  .ba-line {
    flex: 1;
    width: 3px;
    background: rgba(255, 255, 255, 0.9);
  }
  .ba-circle {
    width: 48px;
    height: 48px;
    background: #008080;
    border-radius: 50%;
    display: grid;
    place-items: center;
    box-shadow: 0 4px 18px rgba(0, 128, 128, 0.45);
    flex-shrink: 0;
  }
  .ba-label {
    position: absolute;
    top: 16px;
    background: rgba(0, 0, 0, 0.52);
    color: #fff;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    z-index: 5;
    pointer-events: none;
  }
  .ba-label--left {
    left: 16px;
  }
  .ba-label--right {
    right: 16px;
  }

  @media (max-width: 640px) {
    .ba-slider {
      border-radius: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ba-before {
      transition: none;
    }
  }
</style>

<script>
  const slider = document.getElementById('baSlider');
  const before = document.getElementById('baBefore');
  const handle = document.getElementById('baHandle');

  if (slider && before && handle) {
    let dragging = false;

    function setPosition(clientX: number) {
      const rect = slider!.getBoundingClientRect();
      let pct = (clientX - rect.left) / rect.width;
      pct = Math.min(Math.max(pct, 0.05), 0.95);
      before!.style.clipPath = `inset(0 ${(1 - pct) * 100}% 0 0)`;
      handle!.style.left = `${pct * 100}%`;
    }

    slider.addEventListener('mousedown', (e) => {
      dragging = true;
      setPosition(e.clientX);
    });
    window.addEventListener('mousemove', (e) => {
      if (dragging) setPosition(e.clientX);
    });
    window.addEventListener('mouseup', () => {
      dragging = false;
    });

    slider.addEventListener(
      'touchstart',
      (e) => {
        dragging = true;
        setPosition(e.touches[0].clientX);
      },
      { passive: true }
    );
    window.addEventListener(
      'touchmove',
      (e) => {
        if (dragging) setPosition(e.touches[0].clientX);
      },
      { passive: true }
    );
    window.addEventListener('touchend', () => {
      dragging = false;
    });

    slider.setAttribute('tabindex', '0');
    slider.setAttribute('role', 'slider');
    slider.setAttribute('aria-label', 'Slider înainte și după curățenie');
    slider.addEventListener('keydown', (e) => {
      const rect = slider.getBoundingClientRect();
      const current = parseFloat(handle.style.left || '50') / 100;
      if (e.key === 'ArrowLeft') setPosition(rect.left + (current - 0.05) * rect.width);
      if (e.key === 'ArrowRight') setPosition(rect.left + (current + 0.05) * rect.width);
    });
  }
</script>
