---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout
  title="Mesaj trimis | GNG PureCare"
  description="Am primit mesajul tău. Îți răspundem în 24–48 de ore cu o ofertă personalizată pentru servicii de curățenie în București.">

  <section class="bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-xl px-4 text-center md:px-6">
      <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-primary text-primary-foreground shadow-[var(--shadow-card)]">
        <Icon name="check" class="h-8 w-8 text-primary-foreground"/>
      </div>
      <h1 class="mt-8 font-display text-3xl font-bold tracking-tight md:text-4xl">Mulțumim!</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        Am primit mesajul tău. Revenim în <strong class="text-foreground">24–48 de ore</strong> cu o ofertă personalizată, de obicei mai devreme.
      </p>
      <p class="mt-3 text-sm text-muted-foreground">
        Dacă ai nevoie urgent, sună-ne la <a href="tel:+40747821384" class="font-semibold text-primary hover:underline">0747 821 384</a>.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex h-12 items-center rounded-full bg-primary px-7 text-sm font-semibold text-primary-foreground hover:bg-primary-hover">
          Înapoi acasă
        </a>
        <a href="/servicii" class="inline-flex h-12 items-center rounded-full border-2 border-foreground/15 px-7 text-sm font-semibold hover:border-primary hover:text-primary">
          Vezi serviciile
        </a>
      </div>
    </div>
  </section>
</Layout>
