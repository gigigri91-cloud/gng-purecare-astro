---
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';
---
<Layout
  title="Pagina nu a fost găsită | GNG PureCare"
  description="Pagina căutată nu există. Descoperă serviciile GNG PureCare de curățenie profesională în București."
  noindex={true}
>
  <section class="bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-xl px-4 text-center md:px-6">
      <p class="font-display text-7xl font-extrabold tracking-tight text-primary md:text-8xl">404</p>
      <h1 class="mt-6 font-display text-3xl font-bold tracking-tight md:text-4xl">Pagina nu a fost găsită</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        Adresa accesată nu există sau a fost mutată. Te ajutăm să ajungi unde trebuie.
      </p>
      <p class="mt-3 text-sm text-muted-foreground">
        Sau sună-ne direct la <a href={business.telephoneHref} class="font-semibold text-primary hover:underline">{business.telephoneDisplay}</a>.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex h-12 items-center rounded-full bg-primary px-7 text-sm font-semibold text-primary-foreground hover:bg-primary-hover">
          Înapoi acasă
        </a>
        <a href="/servicii/" class="inline-flex h-12 items-center rounded-full border-2 border-foreground/15 px-7 text-sm font-semibold hover:border-primary hover:text-primary">
          Vezi serviciile
        </a>
        <a href="/contact/" class="inline-flex h-12 items-center rounded-full border-2 border-foreground/15 px-7 text-sm font-semibold hover:border-primary hover:text-primary">
          Contact
        </a>
      </div>
    </div>
  </section>
</Layout>
