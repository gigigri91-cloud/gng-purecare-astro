---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { business } from '../data/business';

const TRUST = ['Echipă profesionistă','Produse sigure și ecologice','Program flexibil','Transparență totală'];

const REASONS = [
  { icon:'eye', title:'Atenție la detalii', desc:'Verificăm fiecare colț și revenim până când rezultatul e impecabil.' },
  { icon:'leaf', title:'Produse sigure pentru familie', desc:'Soluții ecologice, fără chimicale agresive, sigure pentru copii și animale.' },
  { icon:'lock', title:'Transparență totală', desc:'Ofertă clară de la început, fără costuri ascunse și fără surprize.' },
  { icon:'heart', title:'Garanție de satisfacție', desc:'Dacă ceva nu e curat, revenim gratuit.' },
];

const STEPS = [
  { n:'1', t:'Trimiți cererea de ofertă sau ne suni' },
  { n:'2', t:'Confirmăm detaliile și programăm intervenția' },
  { n:'3', t:'Venim pregătiți și livrăm un rezultat impecabil' },
];

const FAQ = [
  { q:'Ce tipuri de spații curățați?', a:'Lucrăm la apartamente, case, birouri, spații comerciale și proprietăți după renovare în București și împrejurimi.' },
  { q:'Lucrați și în weekend sau seara?', a:'Da, lucrăm și în weekend și seara, în funcție de program. Contactează-ne și găsim împreună un interval potrivit.' },
  { q:'Ce include curățenia după renovare?', a:'Eliminarea prafului fin, urmelor de vopsea, var și mortar, spălarea ferestrelor, polișarea pardoselilor și igienizarea completă a băilor și bucătăriei.' },
  { q:'Folosiți produse sigure pentru copii și animale?', a:'Da. Folosim produse profesionale ecologice, fără substanțe agresive, sigure pentru toți membrii familiei.' },
  { q:'În cât timp răspundeți la o cerere de ofertă?', a:'Răspundem în 24–48 de ore, de obicei mult mai rapid.' },
  { q:'Oferiți contracte pentru servicii regulate?', a:'Da. Pentru birouri și clienți recurenți oferim contracte cu condiții preferențiale și program fix.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout
  title="Curățenie Profesională București | GNG PureCare"
  description="Servicii de curățenie profesională în București pentru apartamente, birouri și spații după renovare. Echipă atentă, produse sigure, ofertă rapidă."
  schemaPage="home"
>
  <Hero />


  <!-- TRUST -->
  <section class="bg-surface">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-4 py-10 md:grid-cols-4 md:px-6">
      {TRUST.map(t => (
        <div class="flex items-center gap-2 text-sm font-semibold md:text-base">
          <Icon name="badge" class="h-5 w-5 flex-shrink-0 text-primary"/>
          <span>{t}</span>
        </div>
      ))}
    </div>
  </section>

  <ServiceCards />

  <!-- REASONS -->
  <section class="bg-surface py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="font-display text-3xl font-bold md:text-4xl">De ce aleg clienții GNG PureCare</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {REASONS.map(r => (
          <div class="card-hover rounded-2xl bg-card p-6 shadow-[var(--shadow-soft)]">
            <Icon name={r.icon} class="h-7 w-7 text-primary"/>
            <h3 class="mt-3 font-display text-lg font-semibold">{r.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER -->
  <BeforeAfter />

  <Stats />

  <Testimonials />

  <!-- STEPS -->
  <section class="bg-background py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="font-display text-3xl font-bold md:text-4xl">Simplu, rapid și fără bătăi de cap</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {STEPS.map(s => (
          <div class="rounded-3xl bg-surface p-6">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-primary font-display text-lg font-bold text-primary-foreground">{s.n}</span>
            <p class="mt-4 font-semibold">{s.t}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 text-center">
        <a href={business.telephoneHref} class="phone-cta">
          sau sună direct: {business.telephoneDisplay}
        </a>
      </p>
    </div>
  </section>

  <!-- FORM -->
  <section id="contact" class="bg-surface py-20 scroll-mt-20">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-2 md:px-6">
      <div>
        <h2 class="font-display text-3xl font-bold md:text-4xl">Solicită o ofertă rapidă</h2>
        <p class="mt-3 max-w-md text-muted-foreground">Completează formularul și primești o ofertă personalizată în 24–48 de ore.</p>
        <ul class="mt-6 space-y-3 text-sm">
          <li class="flex items-center gap-2"><Icon name="clock" class="h-5 w-5 text-primary"/> Răspuns în 24–48 de ore</li>
          <li class="flex items-center gap-2"><Icon name="shield" class="h-5 w-5 text-primary"/> Ofertă transparentă</li>
          <li class="flex items-center gap-2"><Icon name="heart" class="h-5 w-5 text-primary"/> Garanție de satisfacție — revenim gratuit dacă e nevoie</li>
        </ul>
      </div>
      <div class="rounded-3xl bg-card p-6 shadow-[var(--shadow-card)] md:p-8">
        <div class="mb-5 inline-flex items-center gap-2 rounded-full bg-primary-soft px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-primary">
          <Icon name="clock" class="h-3.5 w-3.5"/> Răspuns în 24–48h
        </div>
        <ContactForm instanceId="home"/>
      </div>
    </div>
  </section>

  <FaqAccordion items={FAQ} title="Întrebări frecvente" idPrefix="faq" />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<style>
  .phone-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .phone-cta:hover {
    color: var(--color-primary-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
